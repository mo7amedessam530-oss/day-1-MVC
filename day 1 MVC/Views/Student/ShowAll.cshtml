@model IEnumerable<Student>

@{
    ViewData["Title"] = "All Students";
}

<div class="container mt-4">
    <h2>All Students List</h2>
    <table class="table table-bordered table-striped mt-3">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Age</th>
                <th>Department</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var student in Model)
            {
                <tr>
                    <td>@student.Id</td>
                    <td>@student.Name</td>
                    <td>@student.Age</td>
                    <td>@(student.Department?.Name ?? "No Dept")</td>
                    <td>
                        <a asp-action="ShowDetails" asp-route-id="@student.Id" class="btn btn-sm btn-primary">View Details</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
